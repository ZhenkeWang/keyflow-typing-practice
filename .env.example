# Public browser-safe Supabase credentials. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional server-side AI provider key. Keep this out of NEXT_PUBLIC_* variables.
AI_PROVIDER_API_KEY=

