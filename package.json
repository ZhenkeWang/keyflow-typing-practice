{
  "name": "keyflow-typing-practice",
  "version": "1.0.0",
  "description": "An adaptive, privacy-conscious typing training platform with real-time metrics, focused practice modes, and growth insights.",
  "license": "MIT",
  "private": true,
  "homepage": "https://keyflow-typing-practice.barkzoombie.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhenkeWang/keyflow-typing-practice.git"
  },
  "bugs": {
    "url": "https://github.com/ZhenkeWang/keyflow-typing-practice/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/package-sites.mjs",
    "test": "node --test tests/*.test.js",
    "start": "vinext start",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && node scripts/package-sites.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vinext/cloudflare": "^1.0.0-beta.3",
    "framer-motion": "^12.42.2",
    "next": "^16.2.11",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "three": "^0.185.1",
    "vinext": "^1.0.0-beta.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.29",
    "vite": "^8.1.5",
    "wrangler": "^4.113.0"
  },
  "type": "module"
}
